{
  "name": "ticket-qc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "XR Ticket Insight: AI quality review and metadata QC for Zendesk tickets.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prestart": "node server/check-node.cjs",
    "predev": "node server/check-node.cjs",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "html2canvas-pro": "^2.6.0",
    "jsonrepair": "^3.15.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.2",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5"
  }
}
